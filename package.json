{
  "name": "poker-club",
  "version": "0.0.1",
  "description": "A sophisticated multiplayer poker app with virtual chips",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "test:cov": "pnpm -r run test:cov",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "migrate": "pnpm -w -r --filter backend run prisma migrate dev",
    "migrate:prod": "pnpm -w -r --filter backend run prisma migrate deploy",
    "db:push": "pnpm -w -r --filter backend run prisma db push",
    "db:studio": "pnpm -w -r --filter backend run prisma studio"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
