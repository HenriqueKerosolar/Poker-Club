{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": false,
  "module": {
    "type": "commonjs"
  },
  "jsc": {
    "target": "es2020",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    }
  },
  "minify": false,
  "exclude": [".*\\.spec\\.ts$"]
}
