{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@auth/*": ["src/auth/*"],
      "@users/*": ["src/users/*"],
      "@wallets/*": ["src/wallets/*"],
      "@games/*": ["src/games/*"],
      "@tournaments/*": ["src/tournaments/*"],
      "@social/*": ["src/social/*"],
      "@common/*": ["src/common/*"],
      "@shared/*": ["../shared/src/*"]
    }
  }
}
