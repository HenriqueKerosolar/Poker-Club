    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.4.0",
    "expo": "^51.0.0",
    "expo-av": "^13.0.0",
    "expo-camera": "^13.0.0",
    "expo-image-picker": "^14.0.0",
    "expo-router": "^3.0.0",
    "expo-status-bar": "^1.6.0",
    "react": "^18.2.0",
