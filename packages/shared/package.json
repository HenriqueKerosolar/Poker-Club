{
  "name": "@poker-club/shared",
  "version": "0.0.1",
  "description": "Shared types and utilities for Poker Club",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
